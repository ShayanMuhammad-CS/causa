event: query_started
data: {"type":"query_started","hypothesisId":"h-1","sql":"WITH rev AS (\n  SELECT ticker, fiscal_year, period_end, value_usd AS revenue_usd,\n         LAG(value_usd) OVER (PARTITION BY ticker ORDER BY fiscal_year) AS prev_revenue_usd,\n         LAG(fiscal_year) OVER (PARTITION BY ticker ORDER BY fiscal_year) AS prev_fiscal_year\n  FROM edgar.company_financials\n  WHERE concept = 'revenue' AND (ticker = 'F' OR ticker IN (SELECT ticker FROM edgar.company_profile WHERE sic_code IN ('3711')))\n)\nSELECT CASE WHEN ticker = 'F' THEN 'focus' ELSE 'sic_peer' END AS role, ticker, fiscal_year, period_end, revenue_usd,\n       ROUND(100.0 * (revenue_usd - prev_revenue_usd) / prev_revenue_usd, 2) AS yoy_growth_pct\nFROM rev\nWHERE prev_fiscal_year = fiscal_year - 1 AND fiscal_year BETWEEN (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F') - 3 AND (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F')\nORDER BY role, ticker, fiscal_year","purpose":"YoY revenue growth of F and SIC 3711 peers over the window"}
id: 13

