event: query_started
data: {"type":"query_started","hypothesisId":"h-2","sql":"WITH rev AS (\n  SELECT ticker, fiscal_year, period_end, value_usd AS revenue_usd,\n         LAG(value_usd) OVER (PARTITION BY ticker ORDER BY fiscal_year) AS prev_revenue_usd,\n         LAG(fiscal_year) OVER (PARTITION BY ticker ORDER BY fiscal_year) AS prev_fiscal_year\n  FROM edgar.company_financials\n  WHERE concept = 'revenue' AND (ticker = 'F' OR ticker IN (SELECT ticker FROM edgar.company_profile WHERE sic_code IN ('3711')))\n),\ny AS (SELECT * FROM rev WHERE prev_fiscal_year = fiscal_year - 1 AND fiscal_year > (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F') - 3 AND fiscal_year <= (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F'))\nSELECT fiscal_year,\n       MAX(CASE WHEN ticker = 'F' THEN period_end END) AS focus_period_end,\n       ROUND(100.0 * (SUM(CASE WHEN ticker = 'F' THEN revenue_usd END) - SUM(CASE WHEN ticker = 'F' THEN prev_revenue_usd END)) / SUM(CASE WHEN ticker = 'F' THEN prev_revenue_usd END), 2) AS focus_yoy_growth_pct,\n       COUNT(CASE WHEN ticker <> 'F' THEN 1 END) AS peer_companies,\n       SUM(CASE WHEN ticker <> 'F' THEN revenue_usd END) AS peer_revenue_usd,\n       SUM(CASE WHEN ticker <> 'F' THEN prev_revenue_usd END) AS peer_prev_revenue_usd,\n       ROUND(100.0 * (SUM(CASE WHEN ticker <> 'F' THEN revenue_usd END) - SUM(CASE WHEN ticker <> 'F' THEN prev_revenue_usd END)) / SUM(CASE WHEN ticker <> 'F' THEN prev_revenue_usd END), 2) AS peer_yoy_growth_pct\nFROM y\nGROUP BY fiscal_year\nORDER BY fiscal_year","purpose":"Aggregate YoY revenue growth of SIC 3711 peers excluding F (same companies both years) vs F"}
