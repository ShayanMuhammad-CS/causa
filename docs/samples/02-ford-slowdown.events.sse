data: {"type":"query_started","hypothesisId":"h-3","sql":"SELECT year,\n       ROUND(MAX(CASE WHEN indicator_id = 'FP.CPI.TOTL.ZG' THEN value END), 2) AS cpi_inflation_pct,\n       ROUND(MAX(CASE WHEN indicator_id = 'NE.CON.PRVT.KD.ZG' THEN value END), 2) AS real_consumption_growth_pct,\n       ROUND(MAX(CASE WHEN indicator_id = 'NY.GDP.MKTP.KD.ZG' THEN value END), 2) AS real_gdp_growth_pct\nFROM worldbank.us_macro_indicators\nWHERE year > (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F') - 3 AND year <= (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F')\nGROUP BY year\nORDER BY year","purpose":"US CPI inflation, real private consumption growth and real GDP growth (World Bank) over the window"}
id: 32

