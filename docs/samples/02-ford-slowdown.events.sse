event: query_started
data: {"type":"query_started","hypothesisId":"h-4","sql":"SELECT CASE WHEN ticker = 'F' THEN 'focus' ELSE 'sic_peer' END AS role, ticker, fiscal_year,\n       MAX(CASE WHEN concept = 'revenue' THEN period_end END) AS period_end,\n       MAX(CASE WHEN concept = 'revenue' THEN value_usd END) AS revenue_usd,\n       ROUND(100.0 * COALESCE(MAX(CASE WHEN concept = 'gross_profit' THEN value_usd END), MAX(CASE WHEN concept = 'revenue' THEN value_usd END) - MAX(CASE WHEN concept = 'cost_of_revenue' THEN value_usd END)) / MAX(CASE WHEN concept = 'revenue' THEN value_usd END), 2) AS gross_margin_pct,\n       ROUND(100.0 * MAX(CASE WHEN concept = 'operating_income' THEN value_usd END) / MAX(CASE WHEN concept = 'revenue' THEN value_usd END), 2) AS operating_margin_pct\nFROM edgar.company_financials\nWHERE (ticker = 'F' OR ticker IN (SELECT ticker FROM edgar.company_profile WHERE sic_code IN ('3711'))) AND concept IN ('revenue', 'gross_profit', 'cost_of_revenue', 'operating_income')\n  AND fiscal_year BETWEEN (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F') - 3 AND (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'F')\nGROUP BY ticker, fiscal_year\nORDER BY role, ticker, fiscal_year","purpose":"Gross and operating margin of F and SIC 3711 peers over the window"}
