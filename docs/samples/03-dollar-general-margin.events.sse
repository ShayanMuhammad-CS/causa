data: {"type":"query_started","hypothesisId":"h-3","sql":"WITH m AS (\n  SELECT ticker, fiscal_year, MAX(CASE WHEN concept = 'revenue' THEN period_end END) AS period_end,\n         MAX(CASE WHEN concept = 'revenue' THEN value_usd END) AS revenue_usd,\n         COALESCE(MAX(CASE WHEN concept = 'gross_profit' THEN value_usd END), MAX(CASE WHEN concept = 'revenue' THEN value_usd END) - MAX(CASE WHEN concept = 'cost_of_revenue' THEN value_usd END)) AS gross_profit_usd,\n         MAX(CASE WHEN concept = 'operating_income' THEN value_usd END) AS operating_income_usd\n  FROM edgar.company_financials\n  WHERE ticker = 'DG' AND concept IN ('revenue', 'gross_profit', 'cost_of_revenue', 'operating_income') AND fiscal_year BETWEEN (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'DG') - 3 AND (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'DG')\n  GROUP BY ticker, fiscal_year\n)\nSELECT ticker, fiscal_year, period_end, revenue_usd, gross_profit_usd, operating_income_usd,\n       ROUND(100.0 * gross_profit_usd / revenue_usd, 2) AS gross_margin_pct,\n       ROUND(100.0 * operating_income_usd / revenue_usd, 2) AS operating_margin_pct,\n       ROUND(100.0 * (gross_profit_usd - operating_income_usd) / revenue_usd, 2) AS opex_pct_of_revenue\nFROM m\nORDER BY fiscal_year","purpose":"Margin decomposition of DG: gross margin vs operating costs below gross profit, as % of revenue"}
