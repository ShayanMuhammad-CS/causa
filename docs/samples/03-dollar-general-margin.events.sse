event: query_started
data: {"type":"query_started","hypothesisId":"h-2","sql":"WITH m AS (\n  SELECT ticker, fiscal_year, MAX(CASE WHEN concept = 'revenue' THEN value_usd END) AS revenue_usd, MAX(CASE WHEN concept = 'operating_income' THEN value_usd END) AS operating_income_usd\n  FROM edgar.company_financials\n  WHERE (ticker = 'DG' OR ticker IN (SELECT ticker FROM edgar.company_profile WHERE sic_code IN ('5331'))) AND concept IN ('revenue', 'operating_income') AND fiscal_year BETWEEN (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'DG') - 3 AND (SELECT MAX(fiscal_year) FROM edgar.company_financials WHERE concept = 'revenue' AND ticker = 'DG')\n  GROUP BY ticker, fiscal_year\n), c AS (SELECT * FROM m WHERE revenue_usd IS NOT NULL AND operating_income_usd IS NOT NULL)\nSELECT fiscal_year,\n       ROUND(100.0 * SUM(CASE WHEN ticker = 'DG' THEN operating_income_usd END) / SUM(CASE WHEN ticker = 'DG' THEN revenue_usd END), 2) AS focus_operating_margin_pct,\n       COUNT(CASE WHEN ticker <> 'DG' THEN 1 END) AS peer_companies,\n       SUM(CASE WHEN ticker <> 'DG' THEN revenue_usd END) AS peer_revenue_usd,\n       SUM(CASE WHEN ticker <> 'DG' THEN operating_income_usd END) AS peer_operating_income_usd,\n       ROUND(100.0 * SUM(CASE WHEN ticker <> 'DG' THEN operating_income_usd END) / SUM(CASE WHEN ticker <> 'DG' THEN revenue_usd END), 2) AS peer_operating_margin_pct\nFROM c\nGROUP BY fiscal_year\nORDER BY fiscal_year","purpose":"Aggregate operating margin of SIC 5331 peers excluding DG vs DG"}
id: 23

