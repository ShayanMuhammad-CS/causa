# Copy to .env.local and fill in. Never commit .env.local.

# --- Power: Meterless Nightshift (the app's primary AI provider) ---
# Values come from Nightshift -> Console (Runtime/API connection details).
# Your NVIDIA API key goes in Nightshift -> Setup -> Providers, NOT here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# Routing mode or a pinned route from GET /v1/models (pin a Nemotron-backed lane for the NVIDIA award)
METERLESS_MODEL=meterless/auto
CAUSA_MODEL_PLANNER=
CAUSA_MODEL_CRITIC=
# meterless (default, required for submission) | nvidia (dev fallback only, not valid for submission)
CAUSA_LLM_PROVIDER=meterless

# --- Data: Zetaris (local install; API key + org id from the Zetaris UI -> Management) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=

# --- Meterless Scout Intent: contract signing secret (any long random string) ---
CAUSA_CONTRACT_SECRET=

# true = sample mode: real SEC/World Bank data in local DuckDB instead of Zetaris, scripted model instead of Nightshift
SAMPLE_MODE=false
PORT=8700
