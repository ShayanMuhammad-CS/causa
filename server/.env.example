# Copy to .env.local and fill in. Never commit .env.local.

# NVIDIA NIM (https://build.nvidia.com -> any Nemotron model -> Get API Key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CAUSA_MODEL=nvidia/nemotron-3-super-120b-a12b
CAUSA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

# Zetaris (local install defaults; API key + org id from the Zetaris UI -> Management)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=

# Scout Intent contract signing secret (any random string)
CAUSA_CONTRACT_SECRET=

# 1 = run against recorded fixtures (no network)
CAUSA_FAKE=0
PORT=8700
